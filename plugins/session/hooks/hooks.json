{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh SessionStart"
          }
        ]
      },
      {
        "_asha_harnesses": ["claude"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/operational-context.sh"
          }
        ],
        "description": "Claude operational layer; each SessionStart string stays within the 10,000-character hook output cap"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "_asha_harnesses": ["claude", "codex"],
        "hooks": [{"type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh PreToolUse"}]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/block-secrets.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/policy-guard.sh"
          }
        ],
        "description": "Declarative command policy guardrails"
      },
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "_asha_harnesses": ["claude", "codex"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/policy-guard.sh"
          }
        ],
        "description": "Claude file-path policy guardrails"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/post-tool-use.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "_asha_harnesses": ["claude"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh PostToolUseFailure"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/user-prompt-submit.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh UserPromptSubmit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "_asha_harnesses": ["claude"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/session-end.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh SessionEnd"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "_asha_harnesses": ["codex"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh PermissionRequest"
          }
        ]
      }
    ],
    "Stop": [
      {
        "_asha_harnesses": ["claude", "codex"],
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/control-event.sh Stop"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/handlers/verify-pass-complete.sh"
          }
        ]
      }
    ]
  }
}
