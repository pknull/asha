#!/usr/bin/env bash
# bin/asha — Asha cross-agent dispatcher + launcher.
#
# Grammar:  asha [VERB] [HARNESS] [PASSTHROUGH...]
#   VERB     install | uninstall | build | doctor | init-repo
#                                            (optional; absent => launch)
#   HARNESS  claude | codex | copilot | opencode (launch); also both|all for verbs
#            (absent on launch => default_harness from ~/.asha/config.json, else claude)
#   PASSTHROUGH  forwarded to the harness CLI (launch) or to the engine (verb)
#
# Positional by construction, so `asha install claude` (verb+target) and
# `asha claude install` (launch claude, forward `install`) never collide.
#
# Shim form: invoked as asha-claude|asha-codex|asha-copilot|asha-opencode => launch that
# harness with all args passed through.
#
# On launch, if Asha isn't configured for the harness (or is stale), prompt
# [y/N] and run `asha install <harness>` first. Skip the prompt with --yes/-y
# (before the harness) or ASHA_YES=1. A non-interactive launch of an
# unconfigured harness errors instead of hanging.
set -uo pipefail   # no -e: the dispatcher owns its exit codes; install/uninstall run in `set -euo` subshells

# ---- resolve self (portable symlink walk) ----
# asha-bootstrap-symlink-walk: resolve our own real path, portable (readlink -f is GNU-only).
# Duplicated across 6 scripts — find all: `grep -rn asha-bootstrap-symlink-walk`. Cannot DRY into
# lib/portable.sh:resolve_path() — this runs *before* portable.sh is locatable. Keep copies in sync.
__asha_src="${BASH_SOURCE[0]}"
while [ -h "$__asha_src" ]; do
  __asha_dir="$(cd -P "$(dirname "$__asha_src")" >/dev/null 2>&1 && pwd)"
  __asha_src="$(readlink "$__asha_src")"
  case "$__asha_src" in /*) ;; *) __asha_src="$__asha_dir/$__asha_src" ;; esac
done
SCRIPT_DIR="$(cd -P "$(dirname "$__asha_src")" >/dev/null 2>&1 && pwd)"
unset __asha_src __asha_dir
ASHA_ROOT="$(dirname "$SCRIPT_DIR")"
ASHA_HOME="${ASHA_HOME:-$HOME/.asha}"
export ASHA_HOME
export ASHA_ROOT

IDENTITY_DIR="$ASHA_ROOT/identity"
MERGE_SCRIPT="$IDENTITY_DIR/identity-merge.sh"

die()  { echo "asha: ${1:-error}" >&2; exit "${2:-1}"; }
info() { echo "$*" >&2; }

# ---- shared env: secrets + portable helpers ----
# shellcheck source=./asha-env-bootstrap.sh
[[ -r "$SCRIPT_DIR/asha-env-bootstrap.sh" ]] && source "$SCRIPT_DIR/asha-env-bootstrap.sh"
# shellcheck source=../lib/portable.sh
source "$ASHA_ROOT/lib/portable.sh"
# shellcheck source=../harnesses/registry.sh
source "$ASHA_ROOT/harnesses/registry.sh"

is_harness() { asha_harness_exists "${1:-}"; }
is_target()  { asha_target_exists "${1:-}"; }

# Has the harness itself been initialized (its native config exists)? The
# claude/codex harness installers deliberately refuse to fabricate the harness's
# own config file (settings.json / config.toml) and require it to pre-exist;
# copilot bootstraps its own. Used to give a clean message before auto-config.
harness_initialized() {
  asha_harness_requires_native_config "$1" || return 0
  [[ -f "$(asha_harness_native_config "$1")" ]]
}

default_harness() {
  local cfg h
  cfg="${ASHA_CONFIG:-$ASHA_HOME/config.json}"
  h=""
  if [[ -f "$cfg" ]] && command -v jq >/dev/null 2>&1; then
    h="$(jq -r '.default_harness // empty' "$cfg" 2>/dev/null || true)"
  fi
  if [[ -n "$h" ]] && is_harness "$h"; then echo "$h"; else echo claude; fi
}

# Probe: is Asha configured for harness $1?  rc 0 = fresh, 1 = none, 2 = stale.
# Signal = a symlink under ~/.<h>/{skills,agents,commands} that
# resolves into $ASHA_ROOT/plugins/. A link into a *different* .../asha/plugins/
# tree means configured-for-another-checkout (stale).
harness_configured() {
  local h
  h="$1"
  local home
  home="$(asha_harness_home "$h")"
  local sub dir entry tgt foreign
  foreign=0
  local manifest="$ASHA_HOME/install-manifests/$h.json"
  if [[ -s "$manifest" ]]; then
    if jq -e --arg root "$ASHA_ROOT/" \
        '(.artifacts | length) > 0 and (.artifacts | all((.source // "") | startswith($root)))' \
        "$manifest" >/dev/null 2>&1; then
      return 0
    fi
    foreign=1
  fi
  local scan_dirs="skills agents commands"
  [[ "$h" == opencode ]] && scan_dirs="skills agents commands plugins"
  for sub in $scan_dirs; do
    dir="$home/$sub"
    [[ -d "$dir" ]] || continue
    for entry in "$dir"/*; do
      [[ -L "$entry" ]] || continue
      tgt="$(resolve_path "$entry" 2>/dev/null || true)"
      case "$tgt" in
        "$ASHA_ROOT"/plugins/*) return 0 ;;
        */asha/plugins/*)       foreign=1 ;;
      esac
    done
  done
  [[ $foreign -eq 1 ]] && return 2
  return 1
}

maybe_configure() {
  local h="$1" status="$2" reason
  if ! harness_initialized "$h"; then
    info ""
    info "Asha can't configure '$h' yet: $h has not been initialized."
    info "Run '$h' once so it creates its own config (e.g. ~/.$h/), then re-run: asha $h"
    die "$h not initialized (no native config found)"
  fi
  reason="not configured"
  [[ "$status" == "2" ]] && reason="configured for a different asha checkout (stale)"
  info ""
  info "Asha is $reason for '$h'."
  info "Configuring writes symlinks under ~/.$h/, merges hooks into its config,"
  info "and installs ~/.local/bin/asha. (Same as: asha install $h)"
  if [[ "${ASHA_YES:-0}" != "1" && "${ASHA_FLAG_YES:-0}" != "1" ]]; then
    if [[ -t 0 && -t 1 ]]; then
      printf 'Configure Asha for %s now? [y/N] ' "$h" >&2
      local ans; read -r ans || ans=""
      case "$ans" in y|Y|yes|YES) ;; *) die "aborted; not configured for $h" ;; esac
    else
      die "not configured for $h — re-run with --yes or ASHA_YES=1 (or: asha install $h)"
    fi
  fi
  # shellcheck source=../lib/install.sh
  source "$ASHA_ROOT/lib/install.sh"
  ( set -euo pipefail; asha_install_main --target "$h" --bin "$h" ) \
    || die "configuration failed for $h"
}

# ---- per-harness launch (lifted verbatim from the retired wrappers) ----
exec_copilot() {
  local instr cmd
  instr="${ASHA_COPILOT_INSTRUCTIONS_FILE:-$ASHA_HOME/cache/instructions-copilot.md}"
  cmd="$(asha_harness_executable copilot)"

  if ! asha_persona_enabled; then
    # Control-managed worker: operational layer only through the custom
    # instructions dir (Copilot has no usable hook), no identity render.
    local worker_dir worker_op_file worker_op_tmp
    worker_dir="${ASHA_COPILOT_INSTR_DIR:-$ASHA_HOME/cache/copilot-instr-worker}"
    worker_op_file="$worker_dir/.github/instructions/asha-operational.instructions.md"
    worker_op_tmp="$(mktemp)"
    if asha_render_operational_layer "$worker_op_tmp"; then
      mkdir -p "$(dirname "$worker_op_file")"
      { printf -- '---\napplyTo: "**"\n---\n'; cat "$worker_op_tmp"; } > "$worker_op_file"
      rm -f "$worker_op_tmp"
      export COPILOT_CUSTOM_INSTRUCTIONS_DIRS="$worker_dir${COPILOT_CUSTOM_INSTRUCTIONS_DIRS:+,$COPILOT_CUSTOM_INSTRUCTIONS_DIRS}"
    else
      rm -f "$worker_op_tmp"
    fi
    exec "$cmd" "$@"
  fi
  export ASHA_PERSONA=1

  if [[ ! -x "$MERGE_SCRIPT" ]]; then
    info "warn: identity-merge.sh missing; launching plain $cmd (no persona)"
    exec "$cmd" "$@"
  fi
  if ! "$MERGE_SCRIPT" "$instr"; then
    info "warn: identity merge failed; launching plain $cmd"
    exec "$cmd" "$@"
  fi

  # Persona injection — per-launch scoped, mirroring claude's
  # --append-system-prompt-file and codex's model_instructions_file. Copilot CLI
  # (>=1.0.x) auto-loads instructions from any dir named in
  # COPILOT_CUSTOM_INSTRUCTIONS_DIRS, scanning <dir>/.github/instructions/**/*.instructions.md.
  # Wiring it through the launch env (not a committed project file) keeps plain
  # `copilot` persona-free (the escape hatch) and never touches the repo.
  # Empirical (CLI 1.0.63): a bare AGENTS.md in a custom dir is NOT scanned —
  # only the .github/instructions/*.instructions.md form is — so wrap the merged
  # identity in that layout with an applyTo:"**" header. Regenerated every launch.
  local instr_dir instr_file
  instr_dir="${ASHA_COPILOT_INSTR_DIR:-$ASHA_HOME/cache/copilot-instr}"
  instr_file="$instr_dir/.github/instructions/asha.instructions.md"
  mkdir -p "$(dirname "$instr_file")"
  { printf -- '---\napplyTo: "**"\n---\n'; cat "$instr"; } > "$instr_file"

  # Operational layer (operation.md + active learnings) — file-based, so it
  # rides the same custom-instructions dir as a second *.instructions.md. On
  # Claude this content loads via the SessionStart hook; Copilot has no usable
  # hook, so inject it here for behavioral parity. Regenerated every launch;
  # absent/empty → no file written (and any stale copy is cleared).
  local op_merge op_file op_tmp
  op_merge="$IDENTITY_DIR/operational-merge.sh"
  op_file="$instr_dir/.github/instructions/asha-operational.instructions.md"
  op_tmp="$(mktemp)"
  if [[ -x "$op_merge" ]] && "$op_merge" "$op_tmp" 2>/dev/null; then
    { printf -- '---\napplyTo: "**"\n---\n'; cat "$op_tmp"; } > "$op_file"
    info "[asha copilot] operational layer: operation.md + active learnings wired"
  else
    rm -f "$op_file"
  fi
  rm -f "$op_tmp"

  # Chair stance — a third instruction file, same launch-scoped delivery.
  # Stale copies are cleared when the stance does not apply, so a
  # suppressed launch can never read an old brief.
  local chair_file brief
  chair_file="$instr_dir/.github/instructions/asha-chair.instructions.md"
  if asha_orchestrator_stance_enabled; then
    brief="$(asha_orchestrator_brief_file)"
    if [[ -s "$brief" ]]; then
      if ! { printf -- '---\napplyTo: "**"\n---\n'; cat "$brief"; } > "$chair_file" 2>/dev/null; then
        rm -f "$chair_file" 2>/dev/null || true
        info "warn: chair render failed; launching without the chair stance"
      fi
    else
      rm -f "$chair_file" 2>/dev/null || true
      info "warn: orchestrator brief missing; launching without the chair stance"
    fi
  else
    rm -f "$chair_file" 2>/dev/null || true
  fi

  export COPILOT_CUSTOM_INSTRUCTIONS_DIRS="$instr_dir${COPILOT_CUSTOM_INSTRUCTIONS_DIRS:+,$COPILOT_CUSTOM_INSTRUCTIONS_DIRS}"
  info "[asha copilot] persona: wired via COPILOT_CUSTOM_INSTRUCTIONS_DIRS (user-level, this launch only)"
  exec "$cmd" "$@"
}

# ASHA_PERSONA=0 marks a Control-managed worker launch: the harness runs from
# its assignment brief without the identity render. Everything else (hooks,
# skills, the operational layer where file-based, Codex trust injection) is
# unchanged. Any other value, or unset, means the full persona.
asha_persona_enabled() {
  [[ "${ASHA_PERSONA:-1}" != "0" ]]
}

# Control-launched coordinators use the orchestrate-initiative skill instead of
# the operator's chair. An explicit environment setting wins over user config;
# otherwise the chair stance is on unless config disables it exactly.
asha_orchestrator_stance_enabled() {
  local cfg stance
  [[ -z "${ASHA_COORDINATOR_LAUNCH:-}" ]] || return 1
  case "${ASHA_ORCHESTRATOR_STANCE:-}" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  cfg="${ASHA_CONFIG:-$ASHA_HOME/config.json}"
  stance=""
  if [[ -r "$cfg" ]] && command -v jq >/dev/null 2>&1; then
    stance="$(jq -r 'if has("orchestrator_stance") then .orchestrator_stance else empty end' "$cfg" 2>/dev/null || true)"
  fi
  [[ "$stance" != "false" ]]
}

# The chair brief is repository-owned by default, with an override for user
# customization and isolated launcher tests.
asha_orchestrator_brief_file() {
  echo "${ASHA_ORCHESTRATOR_BRIEF_FILE:-$ASHA_ROOT/identity/orchestrator-brief.md}"
}

# Operational layer only (operation.md + active learnings) rendered to $1.
# Returns non-zero when the merge script is missing or produced nothing.
asha_render_operational_layer() {
  local target="$1" op_merge op_tmp
  op_merge="$IDENTITY_DIR/operational-merge.sh"
  [[ -x "$op_merge" ]] || return 1
  op_tmp="$(mktemp)"
  if "$op_merge" "$op_tmp" 2>/dev/null && [[ -s "$op_tmp" ]]; then
    mkdir -p "$(dirname "$target")"
    cat "$op_tmp" >"$target"
    rm -f "$op_tmp"
    return 0
  fi
  rm -f "$op_tmp"
  return 1
}

launch() {
  local h="$1"; shift
  local executable
  executable="$(asha_harness_executable "$h")" || die "unknown harness: $h"
  export ASHA_HARNESS="$h"   # let policy/intervention hooks branch by harness (e.g. ask vs deny)
  case "$h" in
    claude)
      # Management subcommands run their own TUIs / one-shot helpers and must
      # not get --append-system-prompt-file (it forces them out of TTY mode).
      case "${1:-}" in
        agents|auth|auto-mode|doctor|install|mcp|plugin|plugins|project|setup-token|ultrareview|update|upgrade)
          exec "$executable" "$@" ;;
      esac
      if ! asha_persona_enabled; then
        # Control-managed worker: assignment brief, no identity render. The
        # operational layer still arrives through the SessionStart hook.
        exec "$executable" "$@"
      fi
      local id brief chair
      id="${ASHA_CLAUDE_INSTRUCTIONS_FILE:-$ASHA_HOME/cache/instructions.md}"
      export ASHA_PERSONA=1
      if [[ -x "$MERGE_SCRIPT" ]] && "$MERGE_SCRIPT" "$id"; then
        if asha_orchestrator_stance_enabled; then
          brief="$(asha_orchestrator_brief_file)"
          if [[ -s "$brief" ]]; then
            chair="$ASHA_HOME/cache/instructions-claude-chair.md"
            mkdir -p "$(dirname "$chair")"
            if { cat "$id"; printf '\n\n'; cat "$brief"; } > "$chair" 2>/dev/null; then
              exec "$executable" --append-system-prompt-file "$chair" "$@"
            fi
            info "warn: chair render failed; launching with identity only"
          else
            info "warn: orchestrator brief missing; launching without the chair stance"
          fi
        fi
        exec "$executable" --append-system-prompt-file "$id" "$@"
      fi
      info "warn: identity merge failed; launching plain Claude"
      exec "$executable" "$@"
      ;;
    codex)
      local base instr op_merge op_tmp brief trust_root escaped_root
      local operational_applies=0 brief_applies=0
      local -a trust_args=()
      local -a coordinator_args=()
      if [[ "${ASHA_CONTROL_MANAGED:-0}" == "1" || -n "${ASHA_COORDINATOR_LAUNCH:-}" || "${ASHA_SEAT:-0}" == "1" ]]; then
        trust_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)" \
          || trust_root="$PWD"
        if [[ "$trust_root" =~ [[:cntrl:]] ]]; then
          info "warn: Codex trust override skipped: workspace root contains TOML-unsafe control characters"
        else
          escaped_root="${trust_root//\\/\\\\}"
          escaped_root="${escaped_root//\"/\\\"}"
          trust_args=(-c "projects={\"$escaped_root\"={trust_level=\"trusted\"}}")
        fi
      fi
      if [[ -n "${ASHA_COORDINATOR_LAUNCH:-}" ]]; then
        # Any Codex sandbox mode short of full access runs commands in a PID
        # namespace and refuses the tmux socket, which breaks the
        # coordinator's own pane and server proofs (verified live
        # 2026-08-25). The coordinator is the operator's persona-trusted
        # agent running no foreign code; workers stay fully sandboxed.
        coordinator_args=(-a never --sandbox danger-full-access)
      fi
      if ! asha_persona_enabled; then
        # Control-managed worker: operational layer only (Codex has no reliable
        # SessionStart injection), trust override kept, no identity render.
        instr="$ASHA_HOME/cache/instructions-codex-operational.md"
        if asha_render_operational_layer "$instr"; then
          exec "$executable" -c "model_instructions_file=\"$instr\"" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
        fi
        exec "$executable" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
      fi
      base="${ASHA_INSTRUCTIONS_FILE:-$ASHA_HOME/cache/instructions.md}"
      instr="$base"
      if [[ -x "$MERGE_SCRIPT" ]] && "$MERGE_SCRIPT" "$base"; then
        # Operational layer (operation.md + learnings) — codex takes a single
        # model_instructions_file and its SessionStart hook does NOT reliably
        # inject (verified: codex exec doesn't deliver it; same unreliable hook
        # path as PreToolUse/unified_exec). So fold operational into the same
        # file as the identity — the channel we know works. Combined file is
        # regenerated each launch; canonical instructions.md stays identity-only.
        op_merge="$IDENTITY_DIR/operational-merge.sh"
        if [[ -x "$op_merge" ]]; then
          op_tmp="$(mktemp)"
          if "$op_merge" "$op_tmp" 2>/dev/null; then
            operational_applies=1
          fi
        fi
        if asha_orchestrator_stance_enabled; then
          brief="$(asha_orchestrator_brief_file)"
          if [[ -s "$brief" ]]; then
            brief_applies=1
          else
            info "warn: orchestrator brief missing; launching without the chair stance"
          fi
        fi
        if [[ $operational_applies -eq 1 || $brief_applies -eq 1 ]]; then
          if [[ $brief_applies -eq 1 ]]; then
            instr="$ASHA_HOME/cache/instructions-codex-chair.md"
          else
            instr="$ASHA_HOME/cache/instructions-codex.md"
          fi
          mkdir -p "$(dirname "$instr")"
          if {
            cat "$base"
            if [[ $operational_applies -eq 1 ]]; then
              printf '\n\n'
              cat "$op_tmp"
            fi
            if [[ $brief_applies -eq 1 ]]; then
              printf '\n\n'
              cat "$brief"
            fi
          } > "$instr" 2>/dev/null; then
            [[ -z "${op_tmp:-}" ]] || rm -f "$op_tmp"
            exec "$executable" -c "model_instructions_file=\"$instr\"" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
          fi
          [[ -z "${op_tmp:-}" ]] || rm -f "$op_tmp"
          info "warn: combined instructions render failed; launching with identity only"
          exec "$executable" -c "model_instructions_file=\"$base\"" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
        fi
        [[ -z "${op_tmp:-}" ]] || rm -f "$op_tmp"
        exec "$executable" -c "model_instructions_file=\"$instr\"" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
      fi
      info "warn: identity merge failed; launching plain codex"
      exec "$executable" "${trust_args[@]}" "${coordinator_args[@]}" "$@"
      ;;
    copilot)
      exec_copilot "$@"
      ;;
    opencode)
      command -v "$executable" >/dev/null 2>&1 || die "OpenCode executable not found: $executable"
      # shellcheck source=../harnesses/opencode.sh
      source "$ASHA_ROOT/harnesses/opencode.sh"
      opencode_check_version
      local base instr op_merge op_tmp cfg raw_cfg
      base="${ASHA_OPENCODE_INSTRUCTIONS_FILE:-$ASHA_HOME/cache/instructions-opencode.md}"
      instr="$base"
      if ! asha_persona_enabled; then
        # Control-managed worker: operational layer only, no identity render.
        instr="$ASHA_HOME/cache/instructions-opencode-operational.md"
        if asha_render_operational_layer "$instr"; then
          raw_cfg="${OPENCODE_CONFIG_CONTENT:-}"
          [[ -n "$raw_cfg" ]] || raw_cfg='{}'
          cfg="$(jq -cn --argjson base "$raw_cfg" --arg f "$instr" \
            '$base * {instructions: (($base.instructions // []) + [$f] | unique)}')" \
            || die "OPENCODE_CONFIG_CONTENT is not valid OpenCode JSON"
          export OPENCODE_CONFIG_CONTENT="$cfg"
        fi
        exec "$executable" "$@"
      fi
      export ASHA_PERSONA=1
      if [[ -x "$MERGE_SCRIPT" ]] && "$MERGE_SCRIPT" "$base"; then
        # Combined render mirrors the codex branch: identity, then the
        # operational layer when it applies, then the chair brief when the
        # stance applies — in a role-distinct chair file so a stance-off
        # launch never shares a path with a chair render. Writes are
        # guarded; failure falls back to the identity-only file.
        local operational_applies=0 brief_applies=0 brief
        op_merge="$IDENTITY_DIR/operational-merge.sh"
        op_tmp=""
        if [[ -x "$op_merge" ]]; then
          op_tmp="$(mktemp)"
          if "$op_merge" "$op_tmp" 2>/dev/null; then
            operational_applies=1
          fi
        fi
        if asha_orchestrator_stance_enabled; then
          brief="$(asha_orchestrator_brief_file)"
          if [[ -s "$brief" ]]; then
            brief_applies=1
          else
            info "warn: orchestrator brief missing; launching without the chair stance"
          fi
        fi
        if [[ $operational_applies -eq 1 || $brief_applies -eq 1 ]]; then
          if [[ $brief_applies -eq 1 ]]; then
            instr="$ASHA_HOME/cache/instructions-opencode-chair.md"
          else
            instr="$ASHA_HOME/cache/instructions-opencode-combined.md"
          fi
          mkdir -p "$(dirname "$instr")"
          if {
            cat "$base"
            if [[ $operational_applies -eq 1 ]]; then
              printf '\n\n'
              cat "$op_tmp"
            fi
            if [[ $brief_applies -eq 1 ]]; then
              printf '\n\n'
              cat "$brief"
            fi
          } > "$instr" 2>/dev/null; then
            :
          else
            info "warn: combined instructions render failed; launching with identity only"
            instr="$base"
          fi
        fi
        [[ -z "${op_tmp:-}" ]] || rm -f "$op_tmp"
        raw_cfg="${OPENCODE_CONFIG_CONTENT:-}"
        [[ -n "$raw_cfg" ]] || raw_cfg='{}'
        cfg="$(jq -cn --argjson base "$raw_cfg" --arg f "$instr" \
          '$base * {instructions: (($base.instructions // []) + [$f] | unique)}')" \
          || die "OPENCODE_CONFIG_CONTENT is not valid OpenCode JSON"
        export OPENCODE_CONFIG_CONTENT="$cfg"
        exec "$executable" "$@"
      fi
      info "warn: identity merge failed; launching plain opencode"
      exec "$executable" "$@"
      ;;
    *) die "unknown harness: $h" ;;
  esac
}

asha_usage() {
  cat <<'EOF'
asha — cross-agent dispatcher

Usage:
  asha [HARNESS] [args...]         launch a harness (default: configured default, else claude)
  asha install   <target> [...]    provision Asha for a harness (claude|codex|copilot|opencode|both|all)
  asha uninstall <target> [...]    remove Asha from a harness
  asha build copilot [...]         package plugins for Copilot-native distribution
                                   (--only ns,.. --out DIR --version X.Y.Z --dry-run --force)
  asha doctor [target] [--fix]     audit install health (claude|codex|copilot|opencode|all)
                                   (Claude Code's native doctor: asha claude doctor)
  asha workspace status [...]      inspect workspace state and active repository
  asha workspace init|discover|doctor [...]
                                   bootstrap, discover, or validate a workspace
  asha workspace knowledge|promote|worktree|work-item [...]
                                   manage shared knowledge and optional coordination
  asha task start|list|show|attach|stop|archive|reconcile|doctor [...]
                                   manage persistent Control tasks and runs
  asha initiative baseline|create|plan|approve|reject|activate|action|dispatch|pause|resume|stop|cancel|list|show|events|reconcile|storage|snapshot|doctor|projects [...]
                                   manage bounded Orchestration Core initiatives
  asha control [--initiatives|event|tmux]
                                   run the terminal TUI (optionally in Initiatives mode) or Control internals
  asha cockpit [DIR] [--dry-run]   coordinator pane (asha claude at DIR) beside the Initiatives monitor
  asha trigger add|list|remove [...]
                                   schedule coordinator launches (systemd user timers); fired runs wait at plan approval
  asha process route <task>        advisory process route with risks and fallback
  asha capabilities match <task>   registry-backed harness capability match
                                   (both accept --json)
  asha init-repo [--dir D] [...]   scaffold agent/Copilot standards files into a repo
                                   (--dry-run | --check for CI | --force)
  asha-<harness> [args...]         shim form (launch that harness)

Harnesses: claude | codex | copilot | opencode
Flags:
  --yes, -y        skip the first-run configure prompt (or set ASHA_YES=1)

Examples:
  asha codex                       launch codex (first run prompts to configure)
  asha claude install              launch claude, forward `install` to it
  asha install codex               provision Asha for codex
  asha uninstall all               remove Asha from every harness
EOF
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

cmd="$(basename "$0")"
case "$cmd" in
  asha-*) shim_harness="${cmd#asha-}"; is_harness "$shim_harness" && launch "$shim_harness" "$@" ;;
esac

# Dispatcher form (invoked as `asha`).
ASHA_FLAG_YES=0
[[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && { ASHA_FLAG_YES=1; shift; }

case "${1:-}" in
  -h|--help|help) asha_usage; exit 0 ;;
esac

# Triggers are systemd user-timer glue over coordinator launch.
if [[ "${1:-}" == "trigger" ]]; then
  shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/trigger.sh"
  ( set -euo pipefail; asha_trigger_main "$@" )
  exit $?
fi

# The cockpit is tmux layout glue over Control: coordinator pane + monitor.
if [[ "${1:-}" == "cockpit" ]]; then
  shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/cockpit.sh"
  ( set -euo pipefail; asha_cockpit_main "$@" )
  exit $?
fi

# Asha Control owns these public nouns. Route them before harness selection so
# neither can fall through and become a default-harness argument.
if [[ "${1:-}" == "task" || "${1:-}" == "control" || "${1:-}" == "initiative" || "${1:-}" == "migrate" ]]; then
  control_route="$1"; shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/control.sh"
  ( set -euo pipefail; asha_control_main "$control_route" "$@" )
  exit $?
fi

# asha's own install-health audit. Verb-first — `asha claude doctor` still
# reaches Claude Code's native doctor via launch forwarding.
if [[ "${1:-}" == "doctor" ]]; then
  shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/doctor.sh"
  # Same errexit subshell as install/uninstall/build — the engines document
  # this wrapper as their contract; without it a failed write inside the verb
  # would print success and exit 0 (review finding on init-repo).
  ( set -euo pipefail; asha_doctor_main "$@" )
  exit $?
fi

# Workspace inspection and explicit coordination tools. Verb-first; the shell
# router is deliberately thin and leaves flags/validation to each Python core.
if [[ "${1:-}" == "workspace" ]]; then
  shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/workspace.sh"
  ( set -euo pipefail; asha_workspace_main "$@" )
  exit $?
fi

# Process/capability brokerage. These are
# deterministic inline protocols; rendered agents only wrap these commands.
if [[ "${1:-}" == "process" || "${1:-}" == "capabilities" ]]; then
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/broker.sh"
  ( set -euo pipefail; asha_broker_main "$@" )
  exit $?
fi

# Repo scaffolding (explicit branch — the hyphen rules out asha_${verb}_main).
if [[ "${1:-}" == "init-repo" ]]; then
  shift
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/init-repo.sh"
  ( set -euo pipefail; asha_init_repo_main "$@" )
  exit $?
fi

if [[ "${1:-}" == "install" || "${1:-}" == "uninstall" || "${1:-}" == "build" ]]; then
  verb="$1"; shift
  target_arg=""
  if is_target "${1:-}"; then target_arg="$1"; shift; fi
  # shellcheck disable=SC1090
  source "$ASHA_ROOT/lib/$verb.sh"
  if [[ -n "$target_arg" ]]; then
    ( set -euo pipefail; "asha_${verb}_main" --target "$target_arg" "$@" )
  else
    ( set -euo pipefail; "asha_${verb}_main" "$@" )
  fi
  exit $?
fi

# Launch path.
harness=""
if is_harness "${1:-}"; then
  harness="$1"
  shift
fi
[[ -n "$harness" ]] || harness="$(default_harness)"

# The seat: any wrapped no-argument launch is the chair, whichever harness
# holds it. Control-managed launches (coordinator sessions, workers) keep
# their own start directories; arguments keep the caller's cwd.
if [[ $ASHA_FLAG_YES -eq 0 && $# -eq 0 \
      && -z "${ASHA_COORDINATOR_LAUNCH:-}" && "${ASHA_PERSONA:-1}" != "0" ]]; then
  chair_dir="$ASHA_HOME/chair"
  seat_ready=1
  if [[ ! -e "$chair_dir" ]] && ! mkdir -m 700 -- "$chair_dir"; then
    seat_ready=0
  fi
  if [[ $seat_ready -eq 1 ]] && cd -- "$chair_dir"; then
    export ASHA_SEAT=1
    info "[asha] seat: $chair_dir"
  else
    unset ASHA_SEAT
    info "warn: seat directory unavailable; launching from $PWD"
  fi
fi

harness_configured "$harness"; status=$?
[[ $status -ne 0 ]] && maybe_configure "$harness" "$status"
launch "$harness" "$@"
